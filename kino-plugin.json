{
  "id": "pelispanda",
  "name": "Pelispanda",
  "version": "1.0.1",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas, series y animes de pelispanda.org en HD, con reproducción en línea (Latino/Castellano).",
  "author": "Basketboy23",
  "hosts": [
    "pelispanda.org",
    "*.pelispanda.org",
    "vimeos.net",
    "*.vimeos.net",
    "voe.sx",
    "*.voe.sx",
    "doodstream.com",
    "*.doodstream.com",
    "goodstream.one",
    "*.goodstream.one",
    "hlswish.com",
    "*.hlswish.com",
    "filemoon.sx",
    "*.filemoon.sx",
    "videoapp.zip",
    "*.videoapp.zip"
  ],
  "capabilities": ["search", "home", "browse", "episodes", "resolve"],
  "streamHosts": "any",
  "browser": true,
  "color": "#E50914",
  "categories": ["movies", "series", "anime"],
  "debug": false
}

